<script>(function() {
 var toggle = document.getElementById('upload-mode-toggle');
 var serverBtn = document.getElementById('mode-server-btn');
 var batchBtn = document.getElementById('mode-batch-btn');
 var bulkWrap = document.getElementById('bulk-converter-wrap');
 var serverWrap = document.getElementById('server-upload-wrap');
 var bulkOutput = document.getElementById('bulk-output-wrap');
 var cookieName = 'upload_server';

 function getCookie(name) {
 var prefix = name + "=";
 var ca = document.cookie.split(';');
 for (var i = 0; i < ca.length; i++) {
 var c = ca[i].trim();
 if (c.indexOf(prefix) === 0) return c.substring(prefix.length);
 }
 return null;
 }
 function setCookie(name, val) {
 var d = new Date();
 d.setTime(d.getTime() + (365 * 24 * 60 * 60 * 1000));
 document.cookie = name + "=" + val + "; expires=" + d.toUTCString() + "; path=/";
 }
 function applyState(isServer) {
 if (toggle) toggle.checked = !isServer;
 if (serverBtn) serverBtn.classList.toggle('active', isServer);
 if (batchBtn) batchBtn.classList.toggle('active', !isServer);
 if (serverWrap) serverWrap.style.display = isServer ? 'block' : 'none';
 if (bulkWrap) bulkWrap.style.display = isServer ? 'none' : 'block';
 if (bulkOutput) bulkOutput.style.display = isServer ? 'none' : 'block';
 }
 if (bulkWrap && serverWrap) {
 var cookieVal = getCookie(cookieName);
 var isServer = cookieVal === '0' || cookieVal === 'batch' ? false : true;
 applyState(isServer);
 if (toggle) {
 toggle.addEventListener('change', function() {
 var server = !this.checked;
 setCookie(cookieName, server ? '1' : '0');
 applyState(server);
 });
 }
 if (serverBtn) {
 serverBtn.addEventListener('click', function() {
 setCookie(cookieName, '1');
 applyState(true);
 });
 }
 if (batchBtn) {
 batchBtn.addEventListener('click', function() {
 setCookie(cookieName, '0');
 applyState(false);
 });
 }
 }
})();
</script>
